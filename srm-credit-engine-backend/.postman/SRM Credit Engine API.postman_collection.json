    {
      "name": "Settlements",
      "item": [
        {
          "name": "Simulate Settlement",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ── Simulate Settlement – specific assertions ──────────────────────────────\n\nconst json = pm.response.json();\n\npm.test(\"Simulation response contains netPresentValue or equivalent pricing field\", function () {\n    const hasPricingField = json.netPresentValue !== undefined\n        || json.presentValue !== undefined\n        || json.simulatedValue !== undefined\n        || json.discountedValue !== undefined\n        || json.price !== undefined;\n    pm.expect(hasPricingField).to.be.true;\n});\n\npm.test(\"Simulation does not return a persistent ID (no-persist endpoint)\", function () {\n    // A simulation should not create a record; if an id is returned it should be null/undefined\n    if (json.id !== undefined) {\n        pm.expect(json.id).to.be.null;\n    } else {\n        pm.expect(json).to.not.have.property(\"id\");\n    }\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignor\": \"Empresa Cedente LTDA\",\n  \"receivableType\": \"DUPLICATA_MERCANTIL\",\n  \"faceValue\": 100000.00,\n  \"termMonths\": 12,\n  \"baseRate\": 0.010000,\n  \"originalCurrency\": \"USD\",\n  \"paymentCurrency\": \"BRL\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "http://{{base_url}}/api/v1/settlements/simulate",
              "protocol": "http",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "settlements",
                "simulate"
              ]
            },
            "description": "Simular uma operação de cessão de crédito (sem persistência)"
          },
          "response": []
        },
        {
          "name": "Create Settlement",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ── Create Settlement – specific assertions ────────────────────────────────\n\nconst json = pm.response.json();\n\npm.test(\"Created settlement has a persistent ID\", function () {\n    pm.expect(json).to.have.property(\"id\");\n    pm.expect(json.id).to.not.be.null;\n    pm.expect(json.id).to.not.be.undefined;\n});\n\npm.test(\"Created settlement status is present\", function () {\n    pm.expect(json).to.have.property(\"status\");\n    pm.expect(json.status).to.be.a(\"string\").and.to.not.be.empty;\n});\n\npm.test(\"Response status is 201 Created\", function () {\n    pm.expect(pm.response.code).to.eql(201);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignor\": \"Empresa Cedente LTDA\",\n  \"receivableType\": \"DUPLICATA_MERCANTIL\",\n  \"faceValue\": 100000.00,\n  \"termMonths\": 12,\n  \"baseRate\": 0.010000,\n  \"originalCurrency\": \"USD\",\n  \"paymentCurrency\": \"BRL\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "http://{{base_url}}/api/v1/settlements",
              "protocol": "http",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "settlements"
              ]
            },
            "description": "Criar e persistir uma operação de cessão de crédito (precificação atômica)"
          },
          "response": []
        }
      ],
      "description": "Operações de precificação e cessão de crédito",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ── Shared Settlements Folder Validations ──────────────────────────────────",
              "",
              "// 1. HTTP status check",
              "pm.test(\"Status code is 200 or 201\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "// 2. Response time",
              "pm.test(\"Response time is under 3000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "// 3. Content-Type header",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "// 4. Response body is a JSON object",
              "pm.test(\"Response body is a JSON object\", function () {",
              "    pm.response.to.be.json;",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"object\");",
              "});",
              "",
              "// ── Currency field assertions ──────────────────────────────────────────────",
              "",
              "// Parse request body to extract currency fields sent in the request",
              "const reqBody = JSON.parse(pm.request.body.raw || \"{}\");",
              "",
              "pm.test(\"Request body contains originalCurrency\", function () {",
              "    pm.expect(reqBody).to.have.property(\"originalCurrency\");",
              "    pm.expect(reqBody.originalCurrency).to.be.a(\"string\").and.to.have.lengthOf(3);",
              "});",
              "",
              "pm.test(\"Request body contains paymentCurrency\", function () {",
              "    pm.expect(reqBody).to.have.property(\"paymentCurrency\");",
              "    pm.expect(reqBody.paymentCurrency).to.be.a(\"string\").and.to.have.lengthOf(3);",
              "});",
              "",
              "pm.test(\"originalCurrency and paymentCurrency are valid ISO 4217 codes\", function () {",
              "    const validCurrencies = [\"USD\", \"BRL\", \"EUR\", \"GBP\", \"JPY\", \"CHF\", \"CAD\", \"AUD\"];",
              "    pm.expect(validCurrencies).to.include(reqBody.originalCurrency);",
              "    pm.expect(validCurrencies).to.include(reqBody.paymentCurrency);",
              "});",
              "",
              "// ── Receivable field assertions ────────────────────────────────────────────",
              "",
              "pm.test(\"Request body contains receivableType\", function () {",
              "    pm.expect(reqBody).to.have.property(\"receivableType\");",
              "    pm.expect(reqBody.receivableType).to.be.a(\"string\").and.to.not.be.empty;",
              "});",
              "",
              "pm.test(\"Request body contains faceValue and it is a positive number\", function () {",
              "    pm.expect(reqBody).to.have.property(\"faceValue\");",
              "    pm.expect(reqBody.faceValue).to.be.a(\"number\").and.to.be.above(0);",
              "});",
              "",
              "pm.test(\"Request body contains termMonths and it is a positive integer\", function () {",
              "    pm.expect(reqBody).to.have.property(\"termMonths\");",
              "    pm.expect(reqBody.termMonths).to.be.a(\"number\").and.to.satisfy(Number.isInteger).and.to.be.above(0);",
              "});",
              "",
              "pm.test(\"Request body contains baseRate and it is a non-negative number\", function () {",
              "    pm.expect(reqBody).to.have.property(\"baseRate\");",
              "    pm.expect(reqBody.baseRate).to.be.a(\"number\").and.to.be.at.least(0);",
              "});",
              "",
              "// ── Response currency echo assertions ─────────────────────────────────────",
              "",
              "const resJson = pm.response.json();",
              "",
              "if (resJson.originalCurrency !== undefined) {",
              "    pm.test(\"Response originalCurrency matches request\", function () {",
              "        pm.expect(resJson.originalCurrency).to.eql(reqBody.originalCurrency);",
              "    });",
              "}",
              "",
              "if (resJson.paymentCurrency !== undefined) {",
              "    pm.test(\"Response paymentCurrency matches request\", function () {",
              "        pm.expect(resJson.paymentCurrency).to.eql(reqBody.paymentCurrency);",
              "    });",
              "}",
              "",
              "if (resJson.receivableType !== undefined) {",
              "    pm.test(\"Response receivableType matches request\", function () {",
              "        pm.expect(resJson.receivableType).to.eql(reqBody.receivableType);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
